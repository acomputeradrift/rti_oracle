<UserControl x:Class="OracleByFPCLtd.UI.Panels.ConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="ConnectHeaderTextControl" Text="Connect" FontWeight="SemiBold" Margin="0,0,0,8" />
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="Processor IP:" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <TextBox x:Name="IpTextBoxControl" Grid.Column="2" Width="180" Height="24"
               ToolTip="Enter the IP address of the RTI main processor" />
      <Button x:Name="ConnectButtonControl" Grid.Column="4" Content="Connect" Width="90" Height="24"
              IsEnabled="False"
              ToolTipService.ShowOnDisabled="True"
              ToolTip="Upload Apex file first" />
      <Button x:Name="DisconnectButtonControl" Grid.Column="6" Content="Disconnect" Width="90" Height="24" IsEnabled="False" />
      <TextBlock x:Name="StatusTextControl" Grid.Column="7" Text="Idle" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" />

      <TextBlock Grid.Row="1" Text="Discovered IPs:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,6,0,0" />
      <ComboBox x:Name="DiscoveredComboControl" Grid.Row="1" Grid.Column="2" Width="180" Height="24" Margin="0,6,0,0" />
      <Button x:Name="DiscoverButtonControl" Grid.Row="1" Grid.Column="4" Content="Discover" Width="90" Height="24" Margin="0,6,0,0" />
    </Grid>
  </Grid>
</UserControl>
