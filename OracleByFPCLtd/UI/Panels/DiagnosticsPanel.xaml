<UserControl x:Class="OracleByFPCLtd.UI.Panels.DiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OracleByFPCLtd.UI.Controls"
             xmlns:panels="clr-namespace:OracleByFPCLtd.UI.Panels">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:FilterBar x:Name="FilterBarControl" Margin="0,0,0,6" />
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <panels:RawOutputPanel x:Name="RawOutputPanelControl" Grid.Column="0" />
      <GridSplitter Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Opacity="0"
                    Cursor="SizeWE"
                    ShowsPreview="False" />
      <panels:ProcessedOutputPanel x:Name="ProcessedOutputPanelControl" Grid.Column="2" />
    </Grid>
  </Grid>
</UserControl>
