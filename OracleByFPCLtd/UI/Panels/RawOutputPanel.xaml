<UserControl x:Class="OracleByFPCLtd.UI.Panels.RawOutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OracleByFPCLtd.UI.Controls">
  <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3" Padding="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Raw Output" FontWeight="SemiBold" VerticalAlignment="Center" />
        <controls:FindBar x:Name="FindBarControl" Grid.Column="1" HorizontalAlignment="Right" />
      </Grid>
      <controls:LogOutputView x:Name="LogOutputViewControl" Grid.Row="1" />
    </Grid>
  </Border>
</UserControl>
