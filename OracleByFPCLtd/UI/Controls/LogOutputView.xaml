<UserControl x:Class="OracleByFPCLtd.UI.Controls.LogOutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <RichTextBox x:Name="LogTextBoxControl"
               FontFamily="Consolas"
               FontSize="12"
               IsReadOnly="True"
               Background="White"
               Foreground="Black"
               Padding="0"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               AcceptsReturn="True">
    <FlowDocument>
      <Paragraph />
    </FlowDocument>
  </RichTextBox>
</UserControl>
