<UserControl x:Class="OracleByFPCLtd.UI.Controls.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="24">
  <StackPanel Orientation="Horizontal">
    <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0" />
    <TextBox x:Name="FindTextBoxControl" Width="140" Height="24" Margin="0,0,8,0" />
    <Button x:Name="FindPrevButtonControl" Content="Prev" Padding="6,2" Margin="0,0,4,0" IsEnabled="False" />
    <Button x:Name="FindNextButtonControl" Content="Next" Padding="6,2" Margin="0,0,4,0" IsEnabled="False" />
    <Button x:Name="FindClearButtonControl" Content="Clear" Padding="6,2" Margin="0,0,8,0" />
    <TextBlock x:Name="FindCountTextControl" Text="Match: None" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
