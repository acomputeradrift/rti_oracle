<UserControl x:Class="OracleByFPCLtd.UI.Controls.FilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="Diagnostics" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
    <Grid Grid.Column="1" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Filter: Keyword" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBox x:Name="FilterKeywordTextBoxControl" Grid.Column="1" MinWidth="200" Height="24" Margin="0,0,16,0"
               ToolTip="Comma-separated terms. Use +include or -exclude (e.g., Driver Command, IR, -Apple TV)." />
      <TextBlock Grid.Column="2" Text="Start:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Grid Grid.Column="3" MinWidth="200" Margin="0,0,16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FilterStartTextBoxControl" Grid.Column="0" Height="24" Padding="0,0,4,0"
                 ToolTip="Format: yyyy-MM-dd HH:mm" />
        <Button x:Name="FilterStartPickerButtonControl" Grid.Column="1" Content="..." Width="24" Height="24"
                ToolTip="Pick start date" />
      </Grid>
      <TextBlock Grid.Column="4" Text="End:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Grid Grid.Column="5" MinWidth="200" Margin="0,0,16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FilterEndTextBoxControl" Grid.Column="0" Height="24" Padding="0,0,4,0"
                 ToolTip="Format: yyyy-MM-dd HH:mm" />
        <Button x:Name="FilterEndPickerButtonControl" Grid.Column="1" Content="..." Width="24" Height="24"
                ToolTip="Pick end date" />
      </Grid>
      <Button x:Name="FilterApplyButtonControl" Grid.Column="6" Content="Filter" Padding="8,2" Margin="0,0,8,0" />
      <Button x:Name="FilterClearButtonControl" Grid.Column="7" Content="Clear" Padding="8,2" Margin="0,0,8,0" />
      <TextBlock x:Name="FilterCountTextControl" Grid.Column="8" Text="Count: 0" VerticalAlignment="Center" />
    </Grid>
    <Popup x:Name="FilterStartDatePopupControl" PlacementTarget="{Binding ElementName=FilterStartTextBoxControl}" StaysOpen="False">
      <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
        <StackPanel Margin="8">
          <Calendar x:Name="FilterStartCalendarControl" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Time" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="FilterStartHourComboControl" Grid.Column="1" Height="24" />
            <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="6,0" />
            <ComboBox x:Name="FilterStartMinuteComboControl" Grid.Column="3" Height="24" />
          </Grid>
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="FilterEndDatePopupControl" PlacementTarget="{Binding ElementName=FilterEndTextBoxControl}" StaysOpen="False">
      <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
        <StackPanel Margin="8">
          <Calendar x:Name="FilterEndCalendarControl" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Time" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="FilterEndHourComboControl" Grid.Column="1" Height="24" />
            <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="6,0" />
            <ComboBox x:Name="FilterEndMinuteComboControl" Grid.Column="3" Height="24" />
          </Grid>
        </StackPanel>
      </Border>
    </Popup>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="DownloadLogsButtonControl"
              Content="Download Logs"
              Padding="10,2"
              Margin="0,0,8,0" />
      <Button x:Name="ClearDiagnosticsButtonControl"
              Content="Clear Logs"
              Padding="10,2" />
    </StackPanel>
  </Grid>
</UserControl>
