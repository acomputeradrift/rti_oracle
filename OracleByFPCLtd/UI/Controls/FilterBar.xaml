<UserControl x:Class="OracleByFPCLtd.UI.Controls.FilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock x:Name="DiagnosticsHeaderTextControl"
                 Text="Diagnostics"
                 FontWeight="Bold"
                 FontSize="16"
                 VerticalAlignment="Center"
                 Margin="0,0,12,0" />
      <Border x:Name="DiagnosticsZoomControlsBorder"
              Height="24"
              BorderBrush="#A0A0A0"
              BorderThickness="1"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="1,0">
          <Button x:Name="DiagnosticsZoomOutButtonControl"
                  Content="-"
                  MinWidth="20"
                  Height="20"
                  Padding="6,0"
                  VerticalAlignment="Center" />
          <Button x:Name="DiagnosticsZoomResetButtonControl"
                  Content="100%"
                  Height="20"
                  Padding="6,0"
                  VerticalAlignment="Center" />
          <Button x:Name="DiagnosticsZoomInButtonControl"
                  Content="+"
                  MinWidth="20"
                  Height="20"
                  Padding="6,0"
                  VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>
    <Grid Grid.Column="1" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Keywords:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBox x:Name="FilterKeywordTextBoxControl" Grid.Column="1" Width="180" Height="24" Margin="0,0,12,0"
               ToolTip="Comma-separated terms. Use +include or -exclude (e.g., Driver Command, IR, -Apple TV)." />
      <TextBlock Grid.Column="2" Text="Start:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Grid Grid.Column="3" Width="180" Margin="0,0,12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="156" />
          <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FilterStartTextBoxControl" Grid.Column="0" Width="156" Height="24" Padding="0,0,4,0"
                 ToolTip="Format: yy-MM-dd h:mm AM/PM" />
        <Button x:Name="FilterStartPickerButtonControl" Grid.Column="1" Content="..." Width="24" Height="24"
                ToolTip="Pick start date" />
      </Grid>
      <TextBlock Grid.Column="4" Text="End:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Grid Grid.Column="5" Width="180" Margin="0,0,12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="156" />
          <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FilterEndTextBoxControl" Grid.Column="0" Width="156" Height="24" Padding="0,0,4,0"
                 ToolTip="Format: yy-MM-dd h:mm AM/PM" />
        <Button x:Name="FilterEndPickerButtonControl" Grid.Column="1" Content="..." Width="24" Height="24"
                ToolTip="Pick end date" />
      </Grid>
      <Button x:Name="FilterApplyButtonControl" Grid.Column="6" Content="Filter" Width="90" Height="24" Padding="8,2" Margin="0,0,6,0" />
      <Button x:Name="FilterClearButtonControl" Grid.Column="7" Content="Clear" Width="90" Height="24" Padding="8,2" Margin="0,0,6,0" />
      <TextBlock x:Name="FilterCountTextControl" Grid.Column="8" Text="Count: 0" Width="90" VerticalAlignment="Center" />
    </Grid>
    <Popup x:Name="FilterStartDatePopupControl" PlacementTarget="{Binding ElementName=FilterStartTextBoxControl}" StaysOpen="True">
      <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
        <StackPanel Margin="8">
          <Calendar x:Name="FilterStartCalendarControl" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="6" />
              <ColumnDefinition Width="68" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Time" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="FilterStartHourComboControl" Grid.Column="1" Height="24" />
            <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="6,0" />
            <ComboBox x:Name="FilterStartMinuteComboControl" Grid.Column="3" Height="24" />
            <ComboBox x:Name="FilterStartPeriodComboControl" Grid.Column="5" Height="24" />
          </Grid>
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="FilterEndDatePopupControl" PlacementTarget="{Binding ElementName=FilterEndTextBoxControl}" StaysOpen="True">
      <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
        <StackPanel Margin="8">
          <Calendar x:Name="FilterEndCalendarControl" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="6" />
              <ColumnDefinition Width="68" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Time" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="FilterEndHourComboControl" Grid.Column="1" Height="24" />
            <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="6,0" />
            <ComboBox x:Name="FilterEndMinuteComboControl" Grid.Column="3" Height="24" />
            <ComboBox x:Name="FilterEndPeriodComboControl" Grid.Column="5" Height="24" />
          </Grid>
        </StackPanel>
      </Border>
    </Popup>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="ClearDiagnosticsButtonControl"
              Content="Clear Logs"
              Width="90"
              Height="24"
              Padding="10,2" />
    </StackPanel>
  </Grid>
</UserControl>
