<Window x:Class="OracleByFPCLtd.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Border Padding="16" BorderBrush="#CCCCCC" BorderThickness="1">
    <StackPanel HorizontalAlignment="Center">
      <TextBlock x:Name="VersionTextBlock"
                 Text="Oracle by FP&amp;C v1"
                 FontSize="16"
                 FontWeight="SemiBold"
                 Margin="0,0,0,12"
                 TextAlignment="Center" />
      <Image Source="pack://application:,,,/feeny-logo-100-circle-black-back.png"
             Width="100"
             Height="100"
             Margin="0,0,0,12"
             Stretch="Uniform" />
      <TextBlock TextAlignment="Center">
        <Hyperlink NavigateUri="https://www.feenypowerandcontrol.com"
                   RequestNavigate="Hyperlink_RequestNavigate">
          www.feenypowerandcontrol.com
        </Hyperlink>
      </TextBlock>
    </StackPanel>
  </Border>
</Window>
