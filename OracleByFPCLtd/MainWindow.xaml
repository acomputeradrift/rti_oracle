<Window x:Class="OracleByFPCLtd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:OracleByFPCLtd.UI.Panels"
        Title="Oracle by FP&amp;C" Height="720" Width="1000" Background="#F3F3F3"
        MinHeight="480" MinWidth="720">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="LevelButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#F3F3F3" />
      <Setter Property="BorderBrush" Value="#BDBDBD" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="DriverToggleStyle" TargetType="ToggleButton">
      <Setter Property="Background" Value="#F3F3F3" />
      <Setter Property="BorderBrush" Value="#BDBDBD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="30" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="#D9F2D9" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="12,6,12,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="DriverLogRow" Height="Auto" />
      <RowDefinition Height="6" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Menu Grid.Row="0" Grid.Column="0" Margin="0,0,0,6" Background="White" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
      <MenuItem Header="_File">
        <MenuItem x:Name="DownloadProcessedLogsMenuItemControl" Header="Download Processed Logs" />
        <MenuItem x:Name="DownloadAdditionalInfoTemplateMenuItemControl" Header="Download Additional Info Template" />
      </MenuItem>
      <MenuItem Header="_Settings">
        <MenuItem x:Name="AutoscrollMenuItemControl" Header="Autoscroll" IsCheckable="True" IsChecked="True" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="DriverProfilesMenuItemControl" Header="Driver Profiles" />
        <MenuItem x:Name="AboutMenuItemControl" Header="About" />
      </MenuItem>
    </Menu>

    <Grid x:Name="TopHeaderGrid" Grid.Row="1" Grid.Column="0" Margin="0,0,0,6" Grid.IsSharedSizeScope="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border x:Name="ConnectBoxBorder"
              Grid.Row="0"
              Grid.Column="4"
              BorderBrush="#CCCCCC"
              BorderThickness="1"
              CornerRadius="4"
              Background="White"
              Padding="6"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">
        <panels:ConnectionPanel x:Name="ConnectionPanel" />
      </Border>

      <Image x:Name="AppLogoImage"
             Grid.Row="0"
             Grid.Column="0"
             Source="pack://application:,,,/feeny-logo-100-circle-black-back.png"
             Width="{Binding ActualHeight, ElementName=ProjectDataBorder}"
             Height="{Binding ActualHeight, ElementName=ProjectDataBorder}"
             Margin="0"
             VerticalAlignment="Center"
             HorizontalAlignment="Center"
             Stretch="Uniform" />

      <Border x:Name="ProjectDataBorder"
              Grid.Row="0"
              Grid.Column="6"
              BorderBrush="#CCCCCC"
              BorderThickness="1"
              CornerRadius="4"
              Background="White"
              Padding="6"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">
        <panels:ProjectDataPanel x:Name="ProjectDataPanel" />
      </Border>

      <Border x:Name="StatusBorder"
              Grid.Row="0"
              Grid.Column="2"
              BorderBrush="#CCCCCC"
              BorderThickness="1"
              CornerRadius="4"
              Background="White"
              Padding="6"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Height="{Binding ActualHeight, ElementName=ProjectDataBorder}">
        <panels:StatusPanel x:Name="StatusPanel" />
      </Border>
    </Grid>

    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Background="White" Padding="6" Margin="0,0,0,0">
      <panels:DriverLogLevelsPanel x:Name="DriverLogLevelsPanel" />
    </Border>

    <GridSplitter x:Name="DriverLogSplitter"
                  Grid.Row="3"
                  Grid.Column="0"
                  Height="6"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="Transparent"
                  Opacity="0"
                  Cursor="SizeNS"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  Visibility="Collapsed"
                  Panel.ZIndex="2" />

    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Background="White" Padding="6" Margin="0,0,0,0">
      <panels:DiagnosticsPanel x:Name="DiagnosticsPanel" />
    </Border>

    <StackPanel Grid.Row="4" Grid.Column="0" Visibility="Collapsed">
      <CheckBox x:Name="TcpCaptureCheckBox" Content="TCP Capture (RAW)" />
      <CheckBox x:Name="SendProbeCheckBox" Content="Send probe on connect (diagnostic)" />
    </StackPanel>

    <Grid x:Name="ReprocessingOverlay"
          Grid.Row="0"
          Grid.RowSpan="5"
          Grid.Column="0"
          Background="#A0000000"
          Visibility="Collapsed"
          Panel.ZIndex="50">
      <Border Width="420"
              Padding="16"
              CornerRadius="6"
              Background="White"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="ReprocessingStatusText"
                     Text="Reprocessing log lines against new Additional Info..."
                     Margin="0,0,0,10"
                     TextWrapping="Wrap"
                     FontWeight="SemiBold" />
          <ProgressBar x:Name="ReprocessingProgressBar"
                       Height="16"
                       Minimum="0"
                       Maximum="100"
                       Value="0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
